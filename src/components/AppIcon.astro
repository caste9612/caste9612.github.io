---
// A project icon at a fixed size, raster icons also at double density.
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  size: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  /** high for the icon a page opens with */
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { project, size, class: className, loading = 'lazy', fetchpriority } = Astro.props;
const raster = project.icon.format !== 'svg';
const classes = [className, project.squareIcon && 'sq'].filter(Boolean).join(' ') || undefined;
---

{
  raster ? (
    <Image class={classes} src={project.icon} width={size} height={size} densities={[1, 2]} alt="" loading={loading} fetchpriority={fetchpriority} />
  ) : (
    <Image class={classes} src={project.icon} width={size} height={size} alt="" loading={loading} fetchpriority={fetchpriority} />
  )
}
