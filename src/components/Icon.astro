---
// Small interface icons used in buttons and links.
const icons = {
  download: { box: '0 0 24 24', stroke: true, body: '<path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"/>' },
  code: { box: '0 0 24 24', stroke: true, body: '<path d="m8.5 8-4 4 4 4M15.5 8l4 4-4 4"/>' },
  arrowDown: { box: '0 0 24 24', stroke: true, body: '<path d="M12 5v14m0 0-5-5m5 5 5-5"/>' },
  arrowRight: { box: '0 0 24 24', stroke: true, body: '<path d="M5 12h14m0 0-5-5m5 5-5 5"/>' },
  external: { box: '0 0 24 24', stroke: true, body: '<path d="M7 17 17 7M9 7h8v8"/>' },
  mail: { box: '0 0 24 24', stroke: true, body: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.8 6.8 8.2 6 8.2-6"/>' },
  linkedin: {
    box: '0 0 24 24',
    stroke: false,
    body: '<path d="M4.98 3.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0zM.22 8h4.56v14H.22V8zm7.5 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v7.44h-4.56v-6.6c0-1.57-.03-3.6-2.2-3.6-2.2 0-2.53 1.72-2.53 3.49V22H7.72V8z"/>',
  },
  github: {
    box: '0 0 16 16',
    stroke: false,
    body: '<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>',
  },
} as const;

interface Props {
  name: keyof typeof icons;
}

const icon = icons[Astro.props.name];
---

{
  icon.stroke ? (
    <svg viewBox={icon.box} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.body} />
  ) : (
    <svg viewBox={icon.box} fill="currentColor" aria-hidden="true" set:html={icon.body} />
  )
}
