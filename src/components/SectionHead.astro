---
interface Props {
  eyebrow: string;
  title: string;
  /** id of the heading, for aria-labelledby */
  id: string;
  lede?: string;
}

const { eyebrow, title, id, lede } = Astro.props;
---

<div class="sec-head reveal">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="sec-title" id={id}>{title}</h2>
  {lede && <p class="sec-lede">{lede}</p>}
</div>
